Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"CG", " ", "coefficients", " ", 
    RowBox[{"redefined", "."}]}], "\[IndentingNewLine]", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"myCG", "[", 
      RowBox[{
      "j1_", ",", "j2_", ",", "j3_", ",", "m1_", ",", "m2_", ",", "m3_"}], 
      "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", "m1", "]"}], "\[LessEqual]", "j1"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", "m2", "]"}], "\[LessEqual]", "j2"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", "m3", "]"}], "\[LessEqual]", "j3"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m1", "+", "m2"}], "\[Equal]", "m3"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"j1", "+", "j2"}], "\[GreaterEqual]", "j3"}], ")"}], "&&", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"j1", "-", "j2"}], "]"}], "\[LessEqual]", "j3"}], ")"}]}], 
       ",", 
       RowBox[{"ClebschGordan", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"j1", ",", "m1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j2", ",", "m2"}], "}"}], ",", 
         RowBox[{"{", 
